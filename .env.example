# =====================================================================
# AgentThreshold — Environment Template (copy to .env, NEVER commit .env)
# =====================================================================

# --- Infrastructure ---
POSTGRES_USER=agentthreshold
POSTGRES_PASSWORD=agentthreshold_dev
POSTGRES_DB=agentthreshold
POSTGRES_HOST=localhost
POSTGRES_PORT=5433
DATABASE_URL=postgresql+psycopg://agentthreshold:agentthreshold_dev@localhost:5433/agentthreshold

REDIS_URL=redis://localhost:6380/0

# --- API Gateway ---
APP_ENV=development
LOG_LEVEL=INFO
# Rotate these; never commit real secrets. Generate: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=change_me_generate_a_long_random_secret
JWT_ALGORITHM=HS256
JWT_ACCESS_TTL_MINUTES=15
JWT_REFRESH_TTL_HOURS=24

# --- OIDC / SSO (enterprise) — configure once provider is chosen ---
OIDC_ISSUER=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=

# --- Default admin bootstrap ---
BOOTSTRAP_ADMIN_EMAIL=admin@agentthreshold.dev
BOOTSTRAP_ADMIN_PASSWORD=ChangeMe_Str0ng!

# --- Blockchain (Phase 5) ---
ETH_RPC_URL=
ETH_RPC_FALLBACK_URL=
CHAIN_ID=8453

# --- AI (Phase 3) ---
ANTHROPIC_API_KEY=